# Postgres connection used by both the backend and node-pg-migrate
DATABASE_URL=postgres://md2:md2@localhost:5432/md2_tracker

# Session
SESSION_SECRET=change-me
COOKIE_SECURE=false

# Server
PORT=3000
NODE_ENV=development

# Registration is locked down by default; the owner account is seeded directly (see backend/scripts/seed.js)
ALLOW_REGISTRATION=false
SEED_USERNAME=admin
SEED_PASSWORD=change-me

{
  "name": "md2-tracker",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "migrate": "npm run migrate:up -w backend",
    "seed": "npm run seed -w backend",
    "test": "npm run test -w backend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "build": "npm run build -w frontend"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true
  }
}

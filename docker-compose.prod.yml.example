# What Arcane runs. Copy this to docker-compose.prod.yml (gitignored) and fill in your own
# domain/network names — that file is untracked so real endpoint details don't end up in git.
#
# This shape assumes an external Traefik reverse proxy on a shared Docker network; adjust the
# app service's `networks`/`labels` block (or drop it) if you're not using Traefik.
services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: md2
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: md2_tracker
    volumes:
      - md2_db_data:/var/lib/postgresql/data
    networks:
      - md2_tracker
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U md2']
      interval: 5s
      timeout: 5s
      retries: 10

  app:
    image: ${IMAGE:-ghcr.io/daoenti/md2-tracker:latest}
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://md2:${POSTGRES_PASSWORD}@db:5432/md2_tracker
      SESSION_SECRET: ${SESSION_SECRET}
      PORT: 3000
      NODE_ENV: production
      ALLOW_REGISTRATION: 'false'
      COOKIE_SECURE: 'true'
    networks:
      - traefik_proxy
      - md2_tracker
    labels:
      traefik.enable: "true"
      # Required whenever this service sits on more than one Docker network — without it
      # Traefik can't tell which one to route through and silently drops the router (404).
      traefik.docker.network: traefik_proxy
      traefik.http.routers.md2tracker.entrypoints: https
      traefik.http.routers.md2tracker.rule: Host(`md2.your-domain.example`)
      traefik.http.routers.md2tracker.tls: "true"
      traefik.http.services.md2tracker.loadbalancer.server.port: "3000"
    depends_on:
      db:
        condition: service_healthy

volumes:
  md2_db_data:

networks:
  md2_tracker:
  traefik_proxy:
    external: true
